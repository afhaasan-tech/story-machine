# Copy this file to .env.local and put your real keys there. Never commit .env.local.
# Server-only: no NEXT_PUBLIC_ prefix, so keys never reach the browser.
OPENROUTER_API_KEY=your-openrouter-key-here

# Optional: narration AND dictation with one key (elevenlabs.io, free plan is about 10 minutes a month)
ELEVENLABS_API_KEY=
# A voice from YOUR account (free plans cannot use library voices); needed for narration
ELEVENLABS_VOICE_ID=

# Optional: free Whisper for dictation, tried first if set (console.groq.com)
GROQ_API_KEY=
