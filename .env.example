# Copy this file to .env.local and put your real keys there. Never commit .env.local.
# Server-only: no NEXT_PUBLIC_ prefix, so keys never reach the browser.
OPENROUTER_API_KEY=your-openrouter-key-here

# Optional: spoken narration (elevenlabs.io, free plan is about 10 minutes a month)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Optional: say the spark out loud (console.groq.com, free Whisper plan)
GROQ_API_KEY=
